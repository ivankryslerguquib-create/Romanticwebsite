<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Romantic Website Premium ❤️</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Playfair+Display:wght@500&family=Dancing+Script:wght@600&display=swap" rel="stylesheet">

<style>
body{
margin:0;
font-family:Poppins;
background:linear-gradient(135deg,#ffe6f0,#fff,#ffd6e0);
overflow-x:hidden;
text-align:center;
}

/* LOCK SCREEN */
.lock{
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:rgba(255,192,203,0.95);
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
z-index:999;
}

.lock input{
padding:10px;
border-radius:10px;
border:1px solid #ff3e7f;
}

/* HERO */
.hero{
height:100vh;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
background:radial-gradient(circle,#ffb6c1,#fff);
}

h1{
font-family:"Playfair Display";
color:#ff3e7f;
}

/* BUTTONS */
button{
padding:10px 20px;
border:none;
border-radius:25px;
background:#ff3e7f;
color:white;
cursor:pointer;
margin:5px;
}

/* GALLERY */
.gallery img{
width:120px;
border-radius:10px;
margin:5px;
transition:0.3s;
}
.gallery img:hover{transform:scale(1.1);}

/* HEARTS */
.heart{
position:absolute;
color:#ff3e7f;
animation:float 6s linear infinite;
}
@keyframes float{
0%{transform:translateY(100vh);}
100%{transform:translateY(-10vh);}
}

footer{
padding:40px;
background:#ffb6c1;
margin-top:50px;
}
</style>
</head>

<body>

<!-- LOCK SCREEN -->
<div class="lock" id="lock">
<h2>Enter Password 💖</h2>
<input type="password" id="pass"/>
<button onclick="checkPass()">Enter</button>
</div>

<!-- HERO -->
<div class="hero">
<h1>Happy Birthday My Love ❤️</h1>
<p>You are my forever person.</p>
<button onclick="playMusic()">🎵 Music</button>
<button onclick="triggerConfetti()">🎉 Surprise</button>
</div>

<!-- STORY -->
<h2>Our Story</h2>
<p>Every moment with you is magic ✨</p>

<!-- GALLERY -->
<h2>Upload Your Memory 📸</h2>
<input type="file" onchange="preview(event)"/>
<div class="gallery" id="gallery"></div>

<!-- FOOTER -->
<footer>Forever & Always ❤️</footer>

<!-- AUDIO -->
<audio id="music" loop>
<source src="https://cdn.pixabay.com/download/audio/2022/02/22/audio_d3b5b1c3c7.mp3?filename=romantic-112191.mp3">
</audio>

<!-- CONFETTI LIB -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<script>

// PASSWORD
function checkPass(){
let p=document.getElementById("pass").value;
if(p==="love123"){
document.getElementById("lock").style.display="none";
}else{
alert("Wrong password 💔");
}
}

// MUSIC
function playMusic(){
let music=document.getElementById("music");
if(music.paused){
music.play();
}else{
music.pause();
}
}

// CONFETTI
function triggerConfetti(){
confetti({
particleCount:200,
spread:100,
origin:{y:0.6}
});
}

// UPLOAD IMAGE
function preview(event){
let file=event.target.files[0];
let reader=new FileReader();

reader.onload=function(){
let img=document.createElement("img");
img.src=reader.result;
document.getElementById("gallery").appendChild(img);
}

reader.readAsDataURL(file);
}

// FLOATING HEARTS
setInterval(()=>{
let heart=document.createElement("div");
heart.innerHTML="❤️";
heart.classList.add("heart");
heart.style.left=Math.random()*100+"vw";
heart.style.fontSize=Math.random()*20+10+"px";
document.body.appendChild(heart);
setTimeout(()=>heart.remove(),6000);
},300);

</script>

</body>
</html>
