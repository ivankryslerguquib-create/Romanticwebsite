<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>My Romantic Website ❤️</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Playfair+Display:wght@500&family=Dancing+Script:wght@600&display=swap" rel="stylesheet">

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
scroll-behavior:smooth;
}

body{
font-family:Poppins, sans-serif;
background:linear-gradient(135deg,#ffe6f0,#fff,#ffd6e0);
overflow-x:hidden;
color:#333;
}

/* HERO */
.hero{
height:100vh;
display:flex;
justify-content:center;
align-items:center;
flex-direction:column;
text-align:center;
position:relative;
background:radial-gradient(circle,#ffb6c1,#fff);
}

.hero h1{
font-family:"Playfair Display";
font-size:3rem;
color:#ff3e7f;
}

.hero p{
margin-top:10px;
max-width:600px;
}

.btn{
margin-top:20px;
padding:12px 25px;
background:#ff3e7f;
color:white;
border:none;
border-radius:30px;
cursor:pointer;
transition:0.3s;
}

.btn:hover{
transform:scale(1.1);
}

/* FLOATING HEARTS */
.heart{
position:absolute;
color:#ff3e7f;
animation:float 6s linear infinite;
}

@keyframes float{
0%{transform:translateY(100vh) scale(0);}
100%{transform:translateY(-10vh) scale(1);}
}

/* SECTIONS */
section{
padding:80px 20px;
text-align:center;
}

h2{
font-family:"Playfair Display";
color:#ff3e7f;
margin-bottom:20px;
}

/* STORY */
.card{
background:rgba(255,255,255,0.5);
backdrop-filter:blur(10px);
padding:20px;
margin:10px;
border-radius:15px;
box-shadow:0 5px 15px rgba(0,0,0,0.1);
}

/* GALLERY */
.gallery{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
gap:10px;
}
.gallery img{
width:100%;
border-radius:10px;
transition:0.3s;
}
.gallery img:hover{
transform:scale(1.1);
}

/* COUNTDOWN */
.countdown{
display:flex;
justify-content:center;
gap:20px;
flex-wrap:wrap;
}
.box{
background:white;
padding:20px;
border-radius:10px;
min-width:80px;
box-shadow:0 5px 10px rgba(0,0,0,0.1);
}

/* LOVE LETTER */
.letter{
background:rgba(255,255,255,0.6);
padding:30px;
max-width:700px;
margin:auto;
border-radius:20px;
font-family:"Dancing Script";
font-size:1.5rem;
}

/* SURPRISE */
.surprise{
background:#ff3e7f;
color:white;
padding:15px 25px;
border:none;
border-radius:30px;
cursor:pointer;
}

/* FOOTER */
footer{
padding:40px;
background:#ffb6c1;
text-align:center;
margin-top:50px;
}

</style>
</head>

<body>

<div class="hero">
<h1>Happy Birthday My Love ❤️</h1>
<p>You are my today, my tomorrow, and my forever.</p>
<button class="btn" onclick="scrollToSection()">Open My Heart</button>
</div>

<section id="story">
<h2>Our Story</h2>
<div class="card">We met like destiny was written for us ❤️</div>
<div class="card">Every moment with you feels like magic ✨</div>
<div class="card">I choose you, always and forever 💍</div>
</section>

<section>
<h2>Photo Gallery</h2>
<div class="gallery">
<img src="https://picsum.photos/200?1"/>
<img src="https://picsum.photos/200?2"/>
<img src="https://picsum.photos/200?3"/>
<img src="https://picsum.photos/200?4"/>
</div>
</section>

<section>
<h2>Countdown</h2>
<div class="countdown">
<div class="box"><div id="days">0</div>Days</div>
<div class="box"><div id="hours">0</div>Hours</div>
<div class="box"><div id="minutes">0</div>Min</div>
<div class="box"><div id="seconds">0</div>Sec</div>
</div>
</section>

<section>
<h2>Love Letter</h2>
<div class="letter">
Every heartbeat of mine whispers your name...  
I love you more than words can ever explain ❤️
</div>
</section>

<section>
<h2>Surprise</h2>
<button class="surprise" onclick="surprise()">Click For A Surprise ❤️</button>
<p id="msg"></p>
</section>

<footer>
Forever and Always, My Love ❤️
</footer>

<script>
// smooth scroll
function scrollToSection(){
document.getElementById("story").scrollIntoView({behavior:"smooth"});
}

// countdown demo (set future date here)
const target = new Date();
target.setDate(target.getDate()+10);

function updateCountdown(){
const now = new Date();
const diff = target - now;

document.getElementById("days").innerText = Math.floor(diff/86400000);
document.getElementById("hours").innerText = Math.floor(diff/3600000)%24;
document.getElementById("minutes").innerText = Math.floor(diff/60000)%60;
document.getElementById("seconds").innerText = Math.floor(diff/1000)%60;
}
setInterval(updateCountdown,1000);

// surprise
function surprise(){
document.getElementById("msg").innerHTML =
"💖 You are my favorite person in the world 💖";
}

// floating hearts
setInterval(()=>{
const heart = document.createElement("div");
heart.classList.add("heart");
heart.innerHTML="❤️";
heart.style.left=Math.random()*100+"vw";
heart.style.fontSize=Math.random()*20+10+"px";
document.body.appendChild(heart);

setTimeout(()=>heart.remove(),6000);
},300);
</script>

</body>
</html>
